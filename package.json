{
  "name": "hermes-agent-browser",
  "private": true,
  "version": "0.1.0",
  "description": "BrowseLens: a Linux-native shared agent browser with isolated agent Spaces over one Chromium profile.",
  "type": "module",
  "license": "MIT",
  "author": "rhyovar",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/rhyovar/hermes-agent-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhyovar/hermes-agent-browser.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:ui\"",
    "dev:electron": "tsx src/main/index.ts",
    "dev:ui": "vite",
    "build": "vite build && tsc -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "validate": "node scripts/manual-validate.mjs"
  },
  "dependencies": {
    "playwright": "^1.55.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.1.0",
    "electron": "^36.0.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
