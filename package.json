{
  "name": "hermes-agent-browser",
  "private": true,
  "version": "0.1.0",
  "description": "BrowseLens: a Linux-native shared agent browser with isolated agent Spaces over one Chromium profile.",
  "type": "module",
  "license": "MIT",
  "author": "rhyovar",
  "bin": {
    "browse-lens": "./cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/rhyovar/hermes-agent-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhyovar/hermes-agent-browser.git"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:ui\"",
    "dev:electron": "electron -r tsx src/main/electron.ts",
    "dev:ui": "vite",
    "build": "npm run build:ui && vite build && tsc -p tsconfig.json",
    "build:ui": "tsc ui/app.ts --outDir ui --target ES2022 --module ESNext --moduleResolution Bundler --esModuleInterop --skipLibCheck --lib ES2022,DOM",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "validate": "node scripts/manual-validate.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "replay": "node scripts/replay.mjs",
    "diff": "node scripts/diff.mjs"
  },
  "dependencies": {
    "playwright": "^1.55.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "agent-browser": "^0.35.1",
    "browselens-plugin-example": "file:examples/browselens-plugin-example",
    "concurrently": "^9.1.0",
    "electron": "^36.0.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
